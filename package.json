{
  "name": "modular-resume",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:closure": "node scripts/run-closure-tests.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:closure && npm run test:ui-acceptance",
    "test:ui-acceptance": "node scripts/run-ui-acceptance-regression.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:stage": "node scripts/release-stage.mjs",
    "verify:release": "npm run verify && npm run release:check",
    "test:security": "node scripts/security-gate.mjs",
    "verify:production": "npm run typecheck && npm run lint && npm run test:closure && npm run test:ui-acceptance && npm run test:security && npm run release:check",
    "test:i18n": "node scripts/i18n-gate.mjs",
    "desktop:prepare": "node electron/prepare-standalone.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:build": "npm run build && npm run desktop:prepare",
    "dist:win": "npm run desktop:build && npm run desktop:stage && electron-builder --win nsis --x64 --publish never",
    "desktop:stage": "node electron/stage-standalone.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "modularResumeRelease": "v1.0-production-trim",
  "main": "electron/main.cjs",
  "build": {
    "appId": "ca.modularresume.hrtest",
    "productName": "Modular Resume",
    "asar": true,
    "files": [
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".desktop-stage",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist-windows"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Modular-Resume-HR-Test-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Modular Resume"
    }
  }
}
